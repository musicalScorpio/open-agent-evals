{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-reliability-lab.dev/schemas/dataset.schema.json",
  "title": "Agent Reliability Lab Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "description", "source", "generator", "cases"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "source": { "enum": ["synthetic", "curated", "production"] },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "seed", "review_status"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 0 },
        "review_status": { "enum": ["unreviewed", "reviewed", "approved"] },
        "notes": { "type": "string" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario", "split"],
        "properties": {
          "scenario": { "type": "string", "pattern": "^suites/.+\\.yaml$" },
          "split": { "enum": ["train", "validation", "test"] }
        }
      }
    },
    "metadata": { "type": "object" }
  }
}
