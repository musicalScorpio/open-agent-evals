{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-reliability-lab.dev/schemas/evaluation-profile.schema.json",
  "title": "Agent Reliability Lab Evaluation Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "evaluators", "telemetry", "result_store"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "fail_fast": { "type": "boolean", "default": false },
    "evaluators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "adapter", "required", "metrics", "config"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "adapter": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "metrics": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "config": { "type": "object" }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "required": ["sinks"],
      "properties": {
        "sinks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "result_store": {
      "type": "object",
      "required": ["adapter", "config"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "config": { "type": "object" }
      }
    }
  }
}

