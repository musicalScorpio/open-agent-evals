{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-reliability-lab.dev/schemas/agent.schema.json",
  "title": "Agent Reliability Lab Agent Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "description", "runtime", "model", "capabilities", "permissions", "limits"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "required": ["adapter", "mode"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["cli", "http", "in_process"] },
        "command": { "type": "string" },
        "working_directory": { "type": "string" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "license", "options"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "endpoint": { "type": "string", "format": "uri" },
        "license": { "type": "string", "minLength": 1 },
        "options": { "type": "object" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_use", "multi_turn", "streaming", "resumable", "permission_handling", "structured_output"],
      "properties": {
        "tool_use": { "type": "boolean" },
        "multi_turn": { "type": "boolean" },
        "streaming": { "type": "boolean" },
        "resumable": { "type": "boolean" },
        "permission_handling": { "type": "boolean" },
        "structured_output": { "type": "boolean" }
      }
    },
    "permissions": {
      "type": "object",
      "required": ["default", "rules"],
      "properties": {
        "default": { "enum": ["allow", "ask", "deny"] },
        "rules": { "type": "object", "additionalProperties": { "enum": ["allow", "ask", "deny"] } }
      }
    },
    "limits": {
      "type": "object",
      "required": ["max_turns", "max_tool_calls", "timeout_seconds"],
      "properties": {
        "max_turns": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 0 },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "metadata": { "type": "object" }
  }
}

